{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/work/blog-composer/demo/:path*",
      "destination": "https://cb-blog-demo.vercel.app/:path*"
    },
    {
      "source": "/_astro/:path*",
      "destination": "https://cb-blog-demo.vercel.app/_astro/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ]
}
